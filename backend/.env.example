DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=barbearia_db
DB_SSL=false
# DB_SSL_CA=cole_o_conteudo_pem_do_certificado_aqui
# DB_SSL_CA_PATH=C:\\caminho\\para\\ca.pem
NODE_ENV=development
PORT=3001
JWT_SECRET=barbearia_dev_secret

# URL do frontend - usada para montar o link enviado no e-mail de recuperação
FRONTEND_URL=http://localhost:3000

# Envio de e-mail (recuperação de senha) - exemplo com Gmail SMTP
# SMTP_PASS deve ser uma "Senha de app" do Google (16 dígitos), NUNCA a senha da conta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha_de_app_de_16_digitos
MAIL_FROM_NAME=Barbearia
MAIL_FROM_ADDRESS=seuemail@gmail.com

# Validade do link de recuperação, em minutos
RESET_TOKEN_EXPIRES_MINUTES=30
